# ==============================================================================
# StudyGen - Common Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studygen
DB_USERNAME=user
DB_PASSWORD=StudyGen123
DB_URL=jdbc:postgresql://localhost:5432/studygen

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_PORT=8080
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Must be at least 32 characters / 256 bits for HMAC SHA-256 signing
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long!
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://studygen.in,https://www.studygen.in

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 6. Frontend Development Configuration (Vite & React)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_URL=/api
VITE_BACKEND_TARGET=http://localhost:8080

# ------------------------------------------------------------------------------
# 7. Production & Docker Orchestration (EC2 / Nginx)
# ------------------------------------------------------------------------------
DOMAIN_NAME=studygen.in
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_MEM_LIMIT=768m
LETSENCRYPT_DIR=/etc/letsencrypt
